# Copy to .env and adjust. All values shown are the built-in defaults.

# HTTP + WebSocket listen port for this gateway service
PORT=8080

# openQ gateway (gw) process - the target of .oq.gw.query
OPENQ_GW_HOST=127.0.0.1
OPENQ_GW_PORT=5013
OPENQ_GW_USER=
OPENQ_GW_PASSWORD=

# ...or several named gw processes, selected per request with ?target=<name>
# (first listed is the default). Overrides OPENQ_GW_HOST/PORT when set.
# The "mon" target here is openQ's monitoring module gw (see README) - it
# serves the `pidstats` and `logs` tables the dashboard's Processes page uses.
#OPENQ_GW_TARGETS=main=127.0.0.1:5013,mon=127.0.0.1:5025

# Pool of q IPC connections to the gw. Each runs one query at a time
# (openQ assigns the queryID server-side, so replies can't be de-muxed
# on a single shared connection).
OPENQ_POOL_SIZE=4
OPENQ_QUERY_TIMEOUT_MS=15000

# Deserialize q longs as BigInt instead of Number (loses precision >2^53).
OPENQ_USE_BIGINT=false

# Optional comma-separated allowlist of queryable tables. Empty = allow any
# name that is a valid q symbol.
OPENQ_TABLES=

# Live streaming source that speaks .u.sub (a tp or rdb process), used by
# the /stream WebSocket. Leave OPENQ_STREAM_PORT empty to disable streaming.
OPENQ_STREAM_HOST=127.0.0.1
OPENQ_STREAM_PORT=
OPENQ_STREAM_USER=
OPENQ_STREAM_PASSWORD=

# CORS origin allowed to call this service (the Vite dev server, typically).
# "*" allows any origin.
CORS_ORIGIN=*

# openQ per-role .log files, for GET /api/logs.
# OPENQ_LOG_DIR defaults to ../../openQ/scripts/logs relative to this service.
OPENQ_LOG_DIR=
# Which <name>.log files to surface. Comma list of exact role names and/or
# "prefix*" globs; "*" alone means every .log file. The dir also accumulates
# stale per-test-run logs (all_*, ...). Default = core roles only. To also see
# every running module (scripts/startupAllByModule.sh writes bymod_<mod>_<role>.log)
# add bymod_*  -- the process label has the bymod_/all_/xtra_ prefix stripped.
OPENQ_LOG_FILES=tp,rdb,hdb,gw,cep,idb,tmphdb,fh,eod,bymod_*
# Max bytes read from the tail of each file per request.
OPENQ_LOG_TAIL_BYTES=1048576
